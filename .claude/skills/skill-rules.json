    "unslop": {
      "priority": "medium",
      "promptTriggers": {
        "keywords": [
          "unslop",
          "de-slop",
          "reads like ai",
          "sounds like ai",
          "tighten this",
          "too wordy",
          "pr description",
          "release notes",
          "rewrite this prose",
          "make this read better"
        ],
        "intentPatterns": [
          "(unslop|de-?slop)",
          "(reads?|sounds?).*(like|as if).*(ai|chatgpt|a robot|generated)",
          "(tighten|clean ?up|rewrite|punch up).*(prose|writing|description|copy|wording)",
          "(write|draft).*(pr description|release notes|changelog|announcement)"
        ]
      }
    },
    "setup-project": {
      "priority": "high",
      "_note": "No promptTriggers by design. Setup is user-invoked only; auto-firing it mid-task would rewrite config nobody asked to change."
    }
  }
}
