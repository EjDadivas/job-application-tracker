    "writing-for-agents": {
      "priority": "medium",
      "promptTriggers": {
        "keywords": [
          "write a skill",
          "new skill",
          "skill description",
          "edit CLAUDE.md",
          "AGENTS.md",
          "slash command",
          "context pointer",
          "skill isn't firing",
          "skill not activating",
          "audit the description"
        ],
        "intentPatterns": [
          "(write|create|edit|improve|audit).*(skill|slash command|claude\\.md|agents\\.md)",
          "(skill|hook|command).*(not|isn'?t|never).*(fir|activat|trigger|run)",
          "(why|how).*(description|pointer).*(trigger|fire|match)"
        ]
