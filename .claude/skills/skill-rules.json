{
  "version": "2.0",
  "description": "Prompt triggers for the skill-activation-prompt hook. Keywords match whole words (case-insensitive); intentPatterns are regexes tested against the lowercased prompt. Nothing else in this file is read by any hook: file-path triggers and enforcement levels were removed because no consumer existed.",
  "skills": {
    "git-commit": {
      "priority": "high",
      "promptTriggers": {
        "keywords": [
          "commit",
          "commit message",
          "conventional commit",
          "semantic commit",
          "stage and commit"
        ],
        "intentPatterns": [
          "(write|create|make|generate|reword|fix).*?commit",
          "(stage|add).*?(and|then).*?commit",
          "(how to|best practice).*?commit.*?(message|format)"
        ]
      }
    },
    "convex": {
      "priority": "high",
      "promptTriggers": {
        "keywords": [
          "convex",
          "query",
          "mutation",
          "schema",
          "defineTable",
          "withIndex",
          "internalMutation",
          "internalQuery",
          "internalAction",
          "ctx.db",
          "validator",
          "v.id",
          "migration",
          "cron",
          "occ"
        ],
        "intentPatterns": [
          "(create|add|implement|write).*?(query|mutation|action|schema|helper|index|validator)",
          "(how to|best practice).*?(convex|query|mutation|schema)",
          "(fix|debug).*?(convex|query|mutation|occ|slow query)"
        ]
      }
    },
